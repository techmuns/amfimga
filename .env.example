# Secrets for the data ingestion script (scripts/ingest). Optional for local runs.
# Copy to `.env` (git-ignored) or export these in your shell / CI secrets.

# scrape.do API key — used to download .xlsx files from fund-house sites that sit
# behind a bot-wall (Akamai). Without it, only the ~open fund houses are fetched
# and the rest are recorded as a known gap (never invented as zeros).
SCRAPEDO_API_KEY=

# Optional fallback proxy for walled downloads if scrape.do is unavailable.
FIRECRAWL_API_KEY=
