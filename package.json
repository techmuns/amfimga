{
  "name": "amfimga",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Dashboard tracking how India's mutual funds buy and sell stocks, month by month.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run derive && npm run derive:aifpms && npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:amfibeas": "tsx scripts/ingest-amfibeas.ts",
    "marketcap": "tsx scripts/marketcap.ts",
    "listings": "tsx scripts/listings.ts",
    "derive": "tsx scripts/derive.ts",
    "derive:aifpms": "tsx scripts/derive-aif-pms.ts",
    "factsheet": "tsx scripts/parse-factsheet.ts",
    "data": "npm run ingest -- --latest && npm run marketcap && npm run listings && npm run derive && npm run derive:aifpms",
    "data:amfibeas": "npm run ingest:amfibeas && npm run marketcap && npm run listings && npm run derive && npm run derive:aifpms"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "pdf-parse": "^2.4.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "undici": "^8.10.0",
    "vite": "^8.2.1",
    "wrangler": "^4.120.0",
    "xlsx": "^0.18.5"
  }
}
